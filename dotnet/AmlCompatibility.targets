<Project>
  <!-- AML 7e9f874 pins SoulsFormatsNEXT 9f5848f, but commit 5fea0f4
       renamed two FLVER.Dummy properties before that dependency did.
       Compile a corrected copy in obj/ using the original property names
       from 5fea0f4's parent. Keep the upstream checkout and format intact. -->
  <UsingTask TaskName="PrepareAmlSoulsSource" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <DummySource ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string code = File.ReadAllText(Source);
        string dummy = File.ReadAllText(DummySource);
        var names = new[] {
          new[] { "UsesAttachBoneIndex", "Flag1" },
          new[] { "NameHash", "Unk34" }
        };
        foreach (var pair in names)
        {
          string reference = "dummy." + pair[0];
          if (!code.Contains(reference) || dummy.Contains(" " + pair[0] + " {"))
            continue;
          if (!dummy.Contains(" " + pair[1] + " {") ||
              code.Split(new[] { reference }, StringSplitOptions.None).Length != 3)
          {
            Log.LogError("AML/SoulsFormats compatibility changed; review {0} before building.", Source);
            return false;
          }
          code = code.Replace(reference, "dummy." + pair[1]);
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != code)
          File.WriteAllText(Destination, code);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PrepareAmlCompatibilitySource" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'AquaModelLibrary.Core'">
    <PropertyGroup>
      <_AmlSoulsSource>$(MSBuildProjectDirectory)/FromSoft/SoulsConvert.cs</_AmlSoulsSource>
      <_AmlSoulsDestination>$(IntermediateOutputPath)SoulsConvert.Compat.cs</_AmlSoulsDestination>
    </PropertyGroup>
    <PrepareAmlSoulsSource Source="$(_AmlSoulsSource)"
      DummySource="$(MSBuildProjectDirectory)/../SoulsFormatsNEXT/SoulsFormats/Formats/FLVER/Dummy.cs"
      Destination="$(_AmlSoulsDestination)" />
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.Filename)%(Compile.Extension)' == 'SoulsConvert.cs'" />
      <Compile Include="$(_AmlSoulsDestination)" />
      <FileWrites Include="$(_AmlSoulsDestination)" />
    </ItemGroup>
  </Target>
  <!-- Narrow fixes for regressions in AML's face-group importer/splitter.
       Apply only to the reviewed source shape; a later upstream change
       requires explicit review instead of silently applying a stale patch. -->
  <UsingTask TaskName="PrepareAmlModelSource" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Kind ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string code = File.ReadAllText(Source).Replace("\r\n", "\n");
        Func<string, string, string, string> replaceOnce = (text, before, after) => {
          int start = text.IndexOf(before, StringComparison.Ordinal);
          if (start < 0 || text.IndexOf(before, start + before.Length, StringComparison.Ordinal) >= 0)
            throw new InvalidOperationException("Expected exactly one reviewed source block in " + Source);
          return text.Substring(0, start) + after + text.Substring(start + before.Length);
        };
        try
        {
          if (Kind == "Importer")
          {
            code = replaceOnce(code,
              "ids.Count < 2 || (tris.faceGroups.Count > ids[2]",
              "ids.Count < 3 || (tris.faceGroups.Count > ids[2]");
          }
          else if (Kind == "Splitter")
          {
            int start = code.IndexOf("        public void SplitMeshTempData(", StringComparison.Ordinal);
            int end = code.IndexOf("        public void SplitByBoneCount(", start, StringComparison.Ordinal);
            string method = code.Substring(start, end - start);
            method = replaceOnce(method,
              "List<int> faceGroups = new List<int>() { 0 }; //Assumes faces to clone are sequential",
              "List<int> faceGroups = Enumerable.Repeat(0, tempTris[meshId].faceGroups.Count).ToList();");
            method = replaceOnce(method, @"                    //Set currentFaceGroupIndex to the first faceGroup. Some meshes will have multiple face groups, but only use a later face group so we have to check this.
                    for (int i = 0; i < tempTris[meshId].faceGroups.Count; i++)
                    {
                        if (tempTris[meshId].faceGroups[i] != 0)
                        {
                            break;
                        }
                        currentFaceGroupIndex = i;
                        faceGroups.Add(0);
                    }
", "");
            method = replaceOnce(method, @"                            //Check if this face exceeds the current faceGroup threshold and so belongs to the next facegroup instead
                            if (facesToClone[f][i] >= (currentFaceGroupStartingFace + tempTris[meshId].faceGroups[currentFaceGroupIndex]))
                            {
                                currentFaceGroupStartingFace = faceGroups.Sum();
                                currentFaceGroupIndex++;
                                faceGroups.Add(1);
                            } else
                            {
                                faceGroups[currentFaceGroupIndex] = faceGroups[currentFaceGroupIndex] + 1;
                            }", @"                            // Thresholds refer to source faces, not faces selected for this material.
                            // Keep empty groups and skip every crossed source group.
                            while (currentFaceGroupIndex + 1 < tempTris[meshId].faceGroups.Count &&
                                facesToClone[f][i] >= currentFaceGroupStartingFace + tempTris[meshId].faceGroups[currentFaceGroupIndex])
                            {
                                currentFaceGroupStartingFace += tempTris[meshId].faceGroups[currentFaceGroupIndex];
                                currentFaceGroupIndex++;
                            }
                            faceGroups[currentFaceGroupIndex]++;");
            code = code.Substring(0, start) + method + code.Substring(end);
          }
          else
            throw new InvalidOperationException("Unknown AML compatibility source: " + Kind);
        }
        catch (Exception error)
        {
          Log.LogError("AML face-group compatibility changed; review before building: {0}", error.Message);
          return false;
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != code)
          File.WriteAllText(Destination, code);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PrepareAmlModelCompatibilitySource" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'AquaModelLibrary.Core' Or '$(MSBuildProjectName)' == 'AquaModelLibrary.Data'">
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AquaModelLibrary.Core'">
      <_AmlModelFile>AssimpModelImporter</_AmlModelFile>
      <_AmlModelSource>$(MSBuildProjectDirectory)/General/$(_AmlModelFile).cs</_AmlModelSource>
      <_AmlModelKind>Importer</_AmlModelKind>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AquaModelLibrary.Data'">
      <_AmlModelFile>AquaObjectCustom</_AmlModelFile>
      <_AmlModelSource>$(MSBuildProjectDirectory)/PSO2/Aqua/$(_AmlModelFile).cs</_AmlModelSource>
      <_AmlModelKind>Splitter</_AmlModelKind>
    </PropertyGroup>
    <PropertyGroup>
      <_AmlModelDestination>$(IntermediateOutputPath)$(_AmlModelFile).Compat.cs</_AmlModelDestination>
    </PropertyGroup>
    <PrepareAmlModelSource Source="$(_AmlModelSource)" Destination="$(_AmlModelDestination)" Kind="$(_AmlModelKind)" />
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.Filename)' == '$(_AmlModelFile)'" />
      <Compile Include="$(_AmlModelDestination)" />
      <FileWrites Include="$(_AmlModelDestination)" />
    </ItemGroup>
  </Target>
</Project>
